DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DBNAME
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.ai.it.ufl.edu/
NAVIGATOR_MODEL=gpt-oss-20b
# Qwen3 (and similar) emit a hidden reasoning block before the answer; for the
# short feedback this app generates that just wastes the token budget and can
# leave the reply blank. Off by default; set true to opt back in.
LLM_ENABLE_THINKING=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INVITE_HUB_BASE_URL=https://inviteinstitutehub.org
INVITE_HUB_USERNAME=YOUR_USERNAME
INVITE_HUB_PASSWORD=YOUR_PASSWORD

# Proactive trigger daemon. Scope is every student with telemetry; when on it
# proactively messages real students on a poll. Set false to keep it off.
TRIGGER_DAEMON_ENABLED=true
TRIGGER_POLL_INTERVAL_S=5

# Daemon tuning (ported from lm-dashboard). All optional.
# TRIGGER_STUDENT_RECENCY_HOURS bounds the scope to students with an event in the
#   last N hours (default 24), so the first tick doesn't fire `inactive` for every
#   historically idle student at once.
# TRIGGER_IDLE_MAX_S is the idle-backoff ceiling (default 30s); quiet ticks grow
#   the sleep toward this, busy ticks snap back to the base interval.
# TRIGGER_DISABLED is a comma-separated list of trigger types to detect-but-not-act-on
#   (e.g. "inactive,explorer"); they're still persisted to agent_triggers.
TRIGGER_STUDENT_RECENCY_HOURS=24
TRIGGER_IDLE_MAX_S=30
# TRIGGER_DISABLED=

# Cloudflare Turnstile bot gate on /v1/* (src/turnstile.py). SESSION_SECRET signs
# the "solved the widget" cookie -- set a long random value in prod, or the
# cookie is forgeable. TURNSTILE_SECRET is the widget's server-side secret from
# the Cloudflare Turnstile dashboard; unset means the gate can't verify anyone.
SESSION_SECRET=change-me-to-a-long-random-value
TURNSTILE_SECRET=your-cloudflare-turnstile-secret

# LLM token budgets. The chat and the research preview's Agent tab (any model, any
# prompt) are open to anyone who passes Turnstile; these caps keep the gateway
# account from being used as a free LLM. A session is one Turnstile cookie (12h).
# LLM_SESSION_TOKEN_LIMIT=150000
# LLM_DAILY_TOKEN_LIMIT=3000000

# Unity avatar speech. All optional.
# TTS runs locally in the backend (Kokoro-82M, services/tts.py); fetch the model once
#   with `python server/scripts/fetch_kokoro.py`. Voice/pace are study knobs.
# TTS_VOICE=af_heart
# TTS_SPEED=1.0
# KOKORO_MODEL / KOKORO_VOICES override the model file paths (default server/models/).
# TRANSCRIBE_MODEL is the speech-to-text model for /generate-feedback-from-voice,
#   served by the LLM provider above.
# TRANSCRIBE_MODEL=granite-speech-4.1-2b-plus   # e.g. on NCSA Lumen

# Host ports compose publishes (both bound to 127.0.0.1). Change them to run a second
# stack beside another on the same server; scripts/deploy.sh health-checks API_PORT.
# API_PORT=8001
# DB_PORT=5433
